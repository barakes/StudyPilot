@baseUrl = http://localhost:5236

### Register a new user
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "bar@example.com",
  "password": "Password123!",
  "displayName": "Bar"
}

### Log in
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "bar@example.com",
  "password": "Password123!"
}

### Get current user (requires login first)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

### Upload a text document (requires login first)
# @name upload
POST {{baseUrl}}/api/documents
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=StudyPilotBoundary

--StudyPilotBoundary
Content-Disposition: form-data; name="File"; filename="notes.txt"
Content-Type: text/plain

< ../samples/notes.txt
--StudyPilotBoundary
Content-Disposition: form-data; name="Title"

Stack and Queue
--StudyPilotBoundary--

### Upload a PDF document (requires login first)
# @name uploadPdf
POST {{baseUrl}}/api/documents
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=StudyPilotBoundary

--StudyPilotBoundary
Content-Disposition: form-data; name="File"; filename="lecture5.pdf"
Content-Type: application/pdf

< ../samples/lecture5.pdf
--StudyPilotBoundary--

### List my documents (requires login first)
GET {{baseUrl}}/api/documents
Authorization: Bearer {{login.response.body.token}}

### Get a single document (requires upload first)
GET {{baseUrl}}/api/documents/{{upload.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### Delete a document (change the number at the end as needed)
DELETE {{baseUrl}}/api/documents/2
Authorization: Bearer {{login.response.body.token}}

### Generate a quiz from a document (requires login first)
# @name generateQuiz
POST {{baseUrl}}/api/quizzes
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "documentId": 1,
  "multipleChoiceCount": 3,
  "openCount": 2
}

### List my quizzes (requires login first)
GET {{baseUrl}}/api/quizzes
Authorization: Bearer {{login.response.body.token}}

### Get a single quiz (requires generate first)
GET {{baseUrl}}/api/quizzes/{{generateQuiz.response.body.id}}
Authorization: Bearer {{login.response.body.token}}